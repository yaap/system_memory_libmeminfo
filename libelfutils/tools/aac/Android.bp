cc_binary_host {
    name: "aac",
    cflags: [
        "-Wall",
        "-Werror",
    ],
    stl: "libc++_static",
    srcs: [
        "aac.cpp",
        "main.cpp",
    ],
    static_libs: [
        "libarchivestager",
        "libelfpolicy",
        "libelfutils",
        "libzipalign",
        "libziparchive",
        "libbase",
        "liblog",
    ],
    target: {
        windows: {
            enabled: true,
        },
        android: {
            shared_libs: ["libz"],
        },
    },
}

cc_test_host {
    name: "aac_test",
    srcs: [
        "aac.cpp",
        "aac_test.cpp",
    ],
    static_libs: [
        "libarchivestager",
        "libelfpolicy",
        "libelfutils",
        "libzipalign",
        "libziparchive",
        "libbase",
        "liblog",
    ],
}
