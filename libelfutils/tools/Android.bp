package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "gen_invalid_elf",
    host_supported: true,
    srcs: [
        "gen_invalid_elf.cpp",
    ],
    static_libs: [
        "libbase",
        "libelfutils",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}

cc_binary {
    name: "compare_elfs",
    host_supported: true,
    srcs: [
        "compare_elfs.cpp",
    ],
    static_libs: [
        "libbase",
        "libelfutils",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
